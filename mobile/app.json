{
  "expo": {
    "name": "Quick Arrival",
    "slug": "quick-arrival",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nfurniel.quickarrival",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Quick Arrival usa tu ubicacion para enseñarte las paradas que tienes cerca."
      }
    },
    "android": {
      "package": "com.nfurniel.quickarrival",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Quick Arrival usa tu ubicacion para enseñarte las paradas que tienes cerca."
        }
      ]
    ]
  }
}
